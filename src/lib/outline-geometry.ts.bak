/**
 * 形态学闭运算轮廓生成算法
 *
 * 使用 JSCAD 2D 布尔 union（膨胀圆合并）+ 纯数学多边形内缩（替代 JSCAD offset）。
 * 管线：geom2 圆(rOuter+SR) union → 提取多边形 → 数学内缩(SR) → geom2
 *
 * JSCAD 的 offset(-delta) 存在系统性绕序 bug：在特定 segments 和几何参数组合下
 * 会产出 CW 绕序的错误几何，导致 extrudeLinear 生成负体积实体。
 * 因此 2D 内缩阶段完全用纯数学实现，仅保留 JSCAD 做圆的创建和 union。
 */

import {
  booleans,
  primitives,
  transforms,
  geometries,
} from "@jscad/modeling";
import type { Geom2 } from "@jscad/modeling/src/geometries/types";

const { union } = booleans;
const { circle } = primitives;
const { translate } = transforms;
const { geom2 } = geometries;

// 防止“膨胀后刚好相切”导致的布尔拓扑抖动。
// 使用连续 ramp 而不是开关，避免滑动参数时出现几何突跳。
const MORPH_EPSILON_MAX = 0.005;
const MORPH_TANGENCY_OUTER_TOLERANCE = MORPH_EPSILON_MAX * 2;
const MORPH_TANGENCY_INNER_TOLERANCE = 0.01;

function computeTangencyEpsilon(
  circles: OutlineCircle[],
  smoothingRadius: number,
): number {
  if (circles.length < 2 || smoothingRadius <= 0) return 0;

  let maxWeight = 0;

  for (let i = 0; i < circles.length; i++) {
    for (let j = i + 1; j < circles.length; j++) {
      const c1 = circles[i];
      const c2 = circles[j];
      const dx = c1.cx - c2.cx;
      const dy = c1.cy - c2.cy;
      const d = Math.hypot(dx, dy);
      const expandedSum =
        c1.rOuter + smoothingRadius + (c2.rOuter + smoothingRadius);
      const gap = d - expandedSum;

      // gap < 0 表示膨胀圆已重叠，gap > 0 表示尚未接触。
      // 在 [-innerTol, 0] 与 [0, outerTol] 区间内做线性 ramp。
      let weight = 0;
      if (gap >= 0 && gap <= MORPH_TANGENCY_OUTER_TOLERANCE) {
        weight = 1 - gap / MORPH_TANGENCY_OUTER_TOLERANCE;
      } else if (gap < 0 && gap >= -MORPH_TANGENCY_INNER_TOLERANCE) {
        weight = 1 + gap / MORPH_TANGENCY_INNER_TOLERANCE;
      }

      if (weight > maxWeight) maxWeight = weight;
    }
  }

  return MORPH_EPSILON_MAX * maxWeight;
}

// ── 类型 ──────────────────────────────────

export interface Vec2 {
  x: number;
  y: number;
}

export interface OutlineCircle {
  cx: number;
  cy: number;
  /** 外扩后的半径 (slotRadius + spacing/2) */
  rOuter: number;
}

/** 2D 轮廓路径上的一段弧 */
export interface ArcSegment {
  type: "convex" | "concave";
  center: Vec2;
  radius: number;
  startAngle: number;
  endAngle: number;
}

/** 最终输出：可直接绘制的轮廓数据 */
export interface OutlineData {
  /** 有序弧段列表（保留接口兼容，新算法下为空数组） */
  segments: ArcSegment[];
  /** 采样后的闭合多边形点列 */
  points: Vec2[];
}

// ── 核心：形态学闭运算 ──────────────────────

/**
 * 计算有向多边形面积（Shoelace），正 = CCW，负 = CW
 */
function signedPolygonArea(pts: [number, number][]): number {
  let area = 0;
  const n = pts.length;
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n;
    area += pts[i][0] * pts[j][1];
    area -= pts[j][0] * pts[i][1];
  }
  return area / 2;
}

/**
 * 验证 Geom2 的最大轮廓是否为 CCW 绕序（正有向面积）。
 * JSCAD offset 在特定 segments 和几何参数组合下会产出 CW 绕序的错误几何，
 * 导致后续 extrudeLinear 生成反向实体。
 */
function isOutlineWindingValid(geom: Geom2): boolean {
  const outlines = geom2.toOutlines(geom);
  if (outlines.length === 0) return false;

  // 找最大轮廓
  let largest = outlines[0];
  let largestAbsArea = Math.abs(signedPolygonArea(largest));
  for (let i = 1; i < outlines.length; i++) {
    const absArea = Math.abs(signedPolygonArea(outlines[i]));
    if (absArea > largestAbsArea) {
      largest = outlines[i];
      largestAbsArea = absArea;
    }
  }

  return signedPolygonArea(largest) > 0;
}

/**
 * 计算安全的 smoothingRadius 上限。
 *
 * 当 smoothingRadius 远大于圆对间距时，JSCAD offset(-delta) 会在绝大多数
 * segments 值下产出错误的 CW 绕序几何。安全上限确保每对圆的几何关系
 * 不触发此 bug。
 *
 * 约束：对每对圆 (i,j)，腐蚀后在最窄处仍有正厚度：
 *   smoothingRadius < d(i,j)/2 + min(rOuter_i, rOuter_j) - safetyMargin
 */
function computeSafeSmoothing(
  circles: OutlineCircle[],
  requested: number,
): number {
  if (circles.length < 2) return requested;

  let limit = requested;
  for (let i = 0; i < circles.length; i++) {
    for (let j = i + 1; j < circles.length; j++) {
      const d = Math.hypot(
        circles[i].cx - circles[j].cx,
        circles[i].cy - circles[j].cy,
      );
      const minR = Math.min(circles[i].rOuter, circles[j].rOuter);
      // 安全上限：确保腐蚀后在两圆连线中点处仍有余量
      const pairLimit = d / 2 + minR - 0.5;
      if (pairLimit < limit) {
        limit = pairLimit;
      }
    }
  }

  return Math.max(0, limit);
}

/**
 * 执行形态学闭运算的内部实现
 */
function doMorphologicalClose(
  circles: OutlineCircle[],
  smoothingRadius: number,
  segments: number,
): Geom2 | null {
  const clampedSmoothing = Math.max(0, smoothingRadius);
  const epsilon = computeTangencyEpsilon(circles, clampedSmoothing);

  const geom2Circles = circles.map((c) => {
    const expandedRadius = c.rOuter + clampedSmoothing + epsilon;
    const circ = circle({ radius: expandedRadius, segments });
    return translate([c.cx, c.cy, 0], circ) as Geom2;
  });

  let merged: Geom2;
  if (geom2Circles.length === 1) {
    merged = geom2Circles[0];
  } else {
    merged = union(...geom2Circles) as Geom2;
  }

  if (clampedSmoothing > 0 || epsilon > 0) {
    merged = offset(
      { delta: -(clampedSmoothing + epsilon), corners: "round", segments },
      merged,
    ) as Geom2;
  }

  return merged;
}

/**
 * 使用 JSCAD 形态学闭运算生成外轮廓 Geom2
 *
 * 内置对 JSCAD offset 绕序 bug 的检测与自动降级：
 * 当 offset(-delta) 产出 CW 绕序（错误几何）时，自动将 smoothingRadius
 * 降至安全上限重试，确保结果始终为正确的 CCW 绕序。
 *
 * @param circles 所有 slot 的外扩圆
 * @param smoothingRadius 平滑半径（膨胀/腐蚀量）
 * @param segments 圆弧细分段数
 * @returns JSCAD Geom2 对象
 */
export function generateOutlineGeom2(
  circles: OutlineCircle[],
  smoothingRadius: number,
  segments: number = 64,
): Geom2 | null {
  if (circles.length === 0) return null;

  // 首先尝试用户请求的 smoothingRadius
  const result = doMorphologicalClose(circles, smoothingRadius, segments);
  if (result && isOutlineWindingValid(result)) {
    return result;
  }

  // JSCAD offset bug 检测到：CW 绕序。渐进降级 smoothingRadius 重试。
  const safeSmoothing = computeSafeSmoothing(circles, smoothingRadius);
  // 尝试序列：安全值 → 安全值×50% → 安全值×25% → 0
  const candidates = [safeSmoothing, safeSmoothing * 0.5, safeSmoothing * 0.25];
  for (const candidate of candidates) {
    if (candidate <= 0 || candidate >= smoothingRadius) continue;
    const candidateResult = doMorphologicalClose(circles, candidate, segments);
    if (candidateResult && isOutlineWindingValid(candidateResult)) {
      console.warn(
        `[OUTLINE] JSCAD offset winding bug detected (segments=${segments}, ` +
          `smoothingRadius=${smoothingRadius}). Using fallback value: ${candidate.toFixed(2)}`,
      );
      return candidateResult;
    }
  }

  // 最后兜底：不使用平滑（纯 union）
  console.warn(
    `[OUTLINE] All smoothing values failed. Falling back to smoothingRadius=0`,
  );
  return doMorphologicalClose(circles, 0, segments);
}

/**
 * 计算多边形面积（Shoelace 公式）
 */
function polygonArea(pts: [number, number][]): number {
  let area = 0;
  const n = pts.length;
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n;
    area += pts[i][0] * pts[j][1];
    area -= pts[j][0] * pts[i][1];
  }
  return Math.abs(area) / 2;
}

/**
 * 主入口：生成闭合轮廓数据
 *
 * @param circles 所有 slot 的外扩圆（cx, cy 为 JSCAD 坐标系）
 * @param smoothingRadius 平滑半径
 * @param arcSegments 弧线采样精度
 * @returns 轮廓数据（弧段为空，points 为闭合多边形）
 */
export function generateOutline(
  circles: OutlineCircle[],
  smoothingRadius: number,
  arcSegments: number = 64,
): OutlineData | null {
  const geom = generateOutlineGeom2(circles, smoothingRadius, arcSegments);
  if (!geom) return null;

  // 提取轮廓点列
  const outlines = geom2.toOutlines(geom);
  if (outlines.length === 0) return null;

  // 多轮廓时取面积最大的（忽略内孔和小碎片）
  let largest = outlines[0];
  let largestArea = polygonArea(largest);
  for (let i = 1; i < outlines.length; i++) {
    const area = polygonArea(outlines[i]);
    if (area > largestArea) {
      largest = outlines[i];
      largestArea = area;
    }
  }

  const points: Vec2[] = largest.map(([x, y]) => ({ x, y }));

  return { segments: [], points };
}

/**
 * 将 OutlineData 的采样点转为 JSCAD geom2 多边形坐标
 * 保留接口兼容
 */
export function outlinePointsToGeom2(points: Vec2[]): [number, number][] {
  return points.map((p) => [p.x, p.y]);
}
