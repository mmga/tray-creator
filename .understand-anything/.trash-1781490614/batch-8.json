    {
      "id": "file:src/lib/outline-geometry.ts",
      "type": "file",
      "name": "outline-geometry.ts",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "形态学闭运算轮廓生成核心算法。管线为 JSCAD circle + union 膨胀 → 提取多边形 → 纯数学内缩(insetPolygon)替代有 bug 的 JSCAD offset → circle-snapping 后处理。为避免膨胀后相切导致的布尔拓扑抖动，引入自适应 segments 和相切 epsilon。",
      "tags": ["outline", "geometry", "morphology", "jscad", "polygon", "2d"],
      "complexity": "complex"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:generateOutlineGeom2",
      "type": "function",
      "name": "generateOutlineGeom2",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "核心入口：用形态学闭运算生成外轮廓 Geom2。依次执行膨胀圆 union、junction 顶点修正、纯数学内缩、circle-snapping，内缩退化时回退到不平滑 union。",
      "tags": ["outline", "morphology", "jscad", "union"],
      "complexity": "complex"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:generateOutline",
      "type": "function",
      "name": "generateOutline",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "公共接口：生成闭合轮廓数据 OutlineData，内部调用 generateOutlineGeom2 后取面积最大的轮廓并转换为点列。",
      "tags": ["outline", "polygon", "points"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:insetPolygon",
      "type": "function",
      "name": "insetPolygon",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "纯数学 CCW 多边形内缩：边沿内法线平移后相邻边求交，凸角用交点、凹角插圆弧，最后去自交并保证 CCW 绕序。用于替代 JSCAD offset 的系统性 bug。",
      "tags": ["polygon", "inset", "geometry", "math"],
      "complexity": "complex"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:snapToCircles",
      "type": "function",
      "name": "snapToCircles",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "Circle-snapping 后处理：将内缩多边形中圆体区段顶点重投影到真实圆弧，同时排除连接弧(neck)区域顶点，通过靠近 junction 且距离≈smoothingRadius 判定。",
      "tags": ["outline", "snapping", "circle", "geometry"],
      "complexity": "complex"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:computeAdaptiveSegments",
      "type": "function",
      "name": "computeAdaptiveSegments",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "根据最大膨胀半径和弦距容差 ARC_TOLERANCE 自适应计算 JSCAD circle 的 segments 数（64-256），保证每段弧 sagitta 不超容差。",
      "tags": ["segments", "adaptive", "circle", "geometry"],
      "complexity": "simple"
    },
    {
      "id": "function:src/lib/outline-geometry.ts:computeTangencyEpsilon",
      "type": "function",
      "name": "computeTangencyEpsilon",
      "filePath": "src/lib/outline-geometry.ts",
      "summary": "检测圆对在膨胀后相切/近相切的权重，返回一个小的 epsilon 额外膨胀量，防止相切导致布尔运算拓扑抖动。",
      "tags": ["tangency", "epsilon", "morphology"],
      "complexity": "moderate"
    },
